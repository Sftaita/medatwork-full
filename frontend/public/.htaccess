DirectoryIndex index.html

# ── Security Headers — Medatwork Frontend ────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.medatwork.be https://*.ingest.de.sentry.io https://*.ingest.sentry.io; frame-ancestors 'none';"
    Header always unset X-Powered-By
    Header always unset Server
</IfModule>
# ─────────────────────────────────────────────────────────────────────────────

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ── Canonical: always land on https://www.medatwork.be ────────────────────

    # 1. HTTP (any host) → HTTPS www  [covers http://medatwork.be and http://www.medatwork.be]
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://www.medatwork.be%{REQUEST_URI} [R=301,L]

    # 2. HTTPS non-www → HTTPS www  [covers https://medatwork.be]
    RewriteCond %{HTTPS} on
    RewriteCond %{HTTP_HOST} !^www\. [NC]
    RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # ── SPA fallback (only reached for https://www.medatwork.be) ─────────────
    RewriteBase /
    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-l
    RewriteRule . /index.html [L]
</IfModule>
